variable "app_name" {
  description = "Name of the application/product these generated artifacts belong to."
  type        = string
  default     = "sampleapp"
}

variable "environment" {
  description = "Deployment environment. Drives which .tfvars file you'd normally pass with -var-file (see envs/dev.tfvars, envs/prod.tfvars)."
  type        = string
  default     = "dev"

  validation {
    condition     = contains(["dev", "staging", "prod"], var.environment)
    error_message = "environment must be one of: dev, staging, prod."
  }
}

variable "feature_flags" {
  description = "List of feature flag names to render into the generated config file."
  type        = list(string)
  default     = ["new-dashboard", "beta-search"]
}

variable "log_level" {
  description = "Log level to render into the generated config file."
  type        = string
  default     = "info"
}

variable "config_format" {
  description = "Format for the rendered config file: json or yaml."
  type        = string
  default     = "json"
}

variable "password_length" {
  description = "Length of the demo password generated by the secrets-placeholder module."
  type        = number
  default     = 24
}

variable "output_dir" {
  description = "Directory (relative to this root module) where generated files are written."
  type        = string
  default     = "./generated"
}
