variable "app_name" {
  description = "Name of the application this config file belongs to."
  type        = string

  validation {
    condition     = length(var.app_name) > 0
    error_message = "app_name must not be empty."
  }
}

variable "environment" {
  description = "Deployment environment (e.g. dev, staging, prod)."
  type        = string

  validation {
    condition     = contains(["dev", "staging", "prod"], var.environment)
    error_message = "environment must be one of: dev, staging, prod."
  }
}

variable "feature_flags" {
  description = "List of feature flag names to enable for this app/environment."
  type        = list(string)
  default     = []
}

variable "log_level" {
  description = "Log level to render into the config file."
  type        = string
  default     = "info"
}

variable "output_dir" {
  description = "Directory (relative or absolute) where the rendered config file will be written."
  type        = string
  default     = "./generated"
}

variable "generated_at_label" {
  description = "Stable label recorded in the rendered config as a 'generated by' marker. Kept static (not a live timestamp) so repeated applies stay idempotent."
  type        = string
  default     = "terraform-managed"
}

variable "format" {
  description = "Output format for the rendered config file. One of: json, yaml."
  type        = string
  default     = "json"

  validation {
    condition     = contains(["json", "yaml"], var.format)
    error_message = "format must be either \"json\" or \"yaml\"."
  }
}
